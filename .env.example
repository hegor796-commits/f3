# Скопируй этот файл в .env и заполни значения. Файл .env НЕ коммитить!

# Токен бота из @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token

# Твой chat_id (узнать: python -m b2b_agent get-chat-id)
TELEGRAM_CHAT_ID=123456789

# Ключ OpenAI API с https://platform.openai.com (для ИИ-фильтра;
# если не задать — агент работает только по ключевым словам)
OPENAI_API_KEY=sk-...
